CREATE TABLE Student (
    Roll_No INT PRIMARY KEY,
    Name VARCHAR(20) NOT NULL,
    Age INT CHECK (Age >= 18),
    Email VARCHAR(30) UNIQUE,
    City VARCHAR(20) DEFAULT 'Chennai'
);

