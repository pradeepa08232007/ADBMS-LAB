DECLARE
    CURSOR c1 IS
        SELECT id, name FROM students;

    v_id students.id%TYPE;
    v_name students.name%TYPE;
BEGIN
    OPEN c1;

    LOOP
        FETCH c1 INTO v_id, v_name;
        EXIT WHEN c1%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE(v_id || ' ' || v_name);
    END LOOP;

    CLOSE c1;
END;
