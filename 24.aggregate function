CREATE TABLE Student (
    Roll_No INT,
    Name VARCHAR(20),
    Marks INT
);

INSERT INTO Student VALUES (101, 'Arun', 85);
INSERT INTO Student VALUES (102, 'Priya', 75);
INSERT INTO Student VALUES (103, 'Rahul', 90);
INSERT INTO Student VALUES (104, 'Anu', 60);

-- COUNT() - counts the number of records
SELECT COUNT(*) AS Total_Students
FROM Student;

-- SUM() - calculates total marks
SELECT SUM(Marks) AS Total_Marks
FROM Student;

-- AVG() - calculates average marks
SELECT AVG(Marks) AS Average_Marks
FROM Student;

-- MAX() - finds highest marks
SELECT MAX(Marks) AS Highest_Marks
FROM Student;

-- MIN() - finds lowest marks
SELECT MIN(Marks) AS Lowest_Marks
FROM Student;
